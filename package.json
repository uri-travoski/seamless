{
  "name": "seamless",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace web & wait",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "test": "npm test --workspace server",
    "seed": "node --import tsx scripts/seed.ts",
    "restore": "node --import tsx --env-file=.env scripts/restore.ts",
    "ai-stub": "node --import tsx scripts/ai-stub.ts"
  }
}
