# Required: encrypts stored account/AI credentials (any long random string)
SEAMLESS_SECRET=change-me-long-random-string

# Server
PORT=4900
DATA_DIR=./data
# Public URL of this instance (used for tracking pixel links + push)
PUBLIC_URL=http://localhost:4900

# Postgres
DATABASE_URL=postgres://seamless:seamless@localhost:5460/seamless

# S3-compatible blob storage (MinIO / R2 / B2)
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=seamless
S3_ACCESS_KEY=seamless
S3_SECRET_KEY=seamless-secret
S3_FORCE_PATH_STYLE=true

# Where database backups go inside the bucket. Always namespaced under an app folder, so
# one bucket can hold several apps' backups without collision. Set this if you change the
# prefix in Settings: the stored setting dies with the server, and a rebuilt box reads this
# to find your backups. For Cloudflare R2 use S3_REGION=auto and S3_FORCE_PATH_STYLE=false.
BACKUP_PREFIX=seamless/
