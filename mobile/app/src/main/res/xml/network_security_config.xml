<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- https is always fine. Plain http is permitted here only so a home-network server
         (192.168.x.x, 10.x.x.x, *.local) can work; ServerUrl/PrivateHttpInterceptor refuse any other
         http address before a request leaves the app. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
