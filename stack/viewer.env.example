# A dedicated "viewing" copy of Seamless: a reference instance that holds old mail.
# Copy to .env.viewer and fill in. See docs/manual/30-viewing-old-mail.md for the whole recipe.

# Locks the instance in Viewing mode: mail is neither sent nor received, and the switch in
# Settings → General → Mode cannot be flipped by mistake. Remove the line to manage it in the app.
SEAMLESS_MODE=viewing

# Its own secret (do NOT reuse the live app's: archives contain no secrets, so you don't need to).
SEAMLESS_SECRET=change-me-another-long-random-string

# Its own web port and address.
PORT=4902
PUBLIC_URL=http://localhost:4902
DATA_DIR=./data-viewer

# Its own database (never the live app's).
DATABASE_URL=postgres://seamless:seamless@localhost:5460/seamless_viewer

# Its own bucket for whatever it stores itself (imported mail is copied in here).
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=seamless-viewer
S3_ACCESS_KEY=seamless
S3_SECRET_KEY=seamless-secret
S3_FORCE_PATH_STYLE=true
S3_BACKUP_BUCKET=seamless-viewer-backups

# Its own mail-client ports, so they do not clash with the live app (or switch them off).
FACADE_IMAP_PORT=1144
FACADE_SMTP_PORT=1588
# FACADE_ENABLED=false
